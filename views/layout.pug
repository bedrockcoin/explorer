doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'Bedrock Coin Explorer'
    link(rel="icon", type="image/svg+xml", href="/images/logo.png")
    link(rel="stylesheet", href="/themes/Bedrock/style.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Source+Sans+Pro:wght@300;400;600&display=swap", rel="stylesheet")

  body
    // Encabezado fijo
    header.main-header
      p.header-message
        | The 
        span.neon-text Bedrock Coin
        |  network is online.

    // Navbar flotante
    nav.navbar-floating
      .navbar-inner
        ul.navbar-links
          li
            a(href="/") Home
          li
            a(href="/blocks", class=(page === 'blocks' ? 'active' : '')) Blocks
          li
            a(href="/address", class=(page === 'address' ? 'active' : '')) Address
          li
            a(href="/tx", class=(page === 'tx' ? 'active' : '')) Transaction
          li
            a(href="/richlist") Rich List
          li
            a(href="/markets") Markets
          li
            a(href="/info") Info
          li
            a(href="/network") Network
          li
            a(href="/reward") Reward
          li
            a(href="/movement") Movement
        .menu-toggle(aria-label="Toggle navigation")
          span
          span
          span

    // Contenido dinámico
    main
      block content

    // Footer
    footer
      .footer-content
        .footer-brand Bedrock Coin Explorer
        .footer-social
          a(href="https://t.me/bedrockcoinoficial", target="_blank")
            i.fab.fa-telegram
          a(href="https://github.com/bedrockcoin/BedrockCoin-BRK---Official-Source", target="_blank")
            i.fab.fa-github
          a(href="https://discord.gg/ZeSW8xm8", target="_blank")
            i.fab.fa-discord
          a(href="https://x.com/bedrockcoinceo?s=21", target="_blank")
            i.fab.fa-x-twitter
        .footer-copyright &copy; 2025 Bedrock Coin. All rights reserved.

    script.
      document.addEventListener('DOMContentLoaded', () => {
        const menuToggle = document.querySelector('.menu-toggle');
        const navLinks = document.querySelector('.navbar-links');
        if (menuToggle && navLinks) {
          menuToggle.addEventListener('click', () => {
            navLinks.classList.toggle('active');
          });
        }
      });